[Unit]
Description=Wildlife Monitor — Daily Analysis
After=network.target remote-fs.target
Wants=remote-fs.target

[Service]
Type=oneshot
User=twostar
WorkingDirectory=/home/twostar/wildlife_monitor
ExecStart=/bin/bash -c '\
    source /home/twostar/wildlife_env/bin/activate && \
    ./nas_sync.sh \
        --then-process \
        --data-dir /home/twostar/wildlife_monitor/data'
StandardOutput=append:/home/twostar/wildlife_monitor/data/cron.log
StandardError=append:/home/twostar/wildlife_monitor/data/cron.log
TimeoutStartSec=43200

[Install]
WantedBy=multi-user.target
